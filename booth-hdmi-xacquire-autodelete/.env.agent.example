# Copy to .env.agent and fill secrets. Do not commit real tokens.
#
# Custom tung booth: CHI SUA FILE NAY (xem ENV-CUSTOMIZATION.md).
# Cung exe + script cho moi site; khac biet = env + WATCH_DIR + ROOM_ID.
#
# VARIANT: giong booth-hdmi-xacquire NHUNG xoa JPG trong WATCH_DIR sau khi upload OK.
# HDMI live view (kiosk webcam) + X Acquire folder watch + optional RR-100 relay.
# KHONG chay chung USB fuji-bridge soft-shutter tren cung may neu dung HDMI path.
# KHONG chay kit nay song song kit goc tren cung WATCH_DIR (kit nay se xoa file truoc).

# --- Bat buoc moi site ---
API_BASE_URL=http://localhost:8080/api/v1
SERVICE_TOKEN=
ROOM_ID=

# X Acquire JPG folder. Agent watch la de quy, nen tro vao thu muc CHA.
# X Acquire tu tao thu muc con moi (582_FUJI, 583_FUJI, ...) khi doi session /
# khi bo dem frame cua may quay vong; tro vao mot thu muc la se im lang bo anh
# ngay khi X Acquire chuyen sang thu muc ke tiep.
# KHONG dung WATCH_DIR=auto cho X Acquire (auto chi DCIM/USB the).
WATCH_DIR=C:\Users\PC\Documents\FUJIFILM\XAcquire
# Optional second drop folder (may thu hai / duong drop song song).
# WATCH_DIR_2=D:\Fuji-drop
AGENT_MODE=booth
AGENT_AUTO_WALKIN=false

# Loopback-only control HTTP (GET /health /status, POST /trigger). Non-loopback bind forbidden.
AGENT_CONTROL_ADDR=127.0.0.1:8791
# File-ready hold: size unchanged for this many ms (±50). Preferred over legacy poll/timeout.
AGENT_STABLE_HOLD_MS=300
# Docs/status mirror of kiosk CAPTURE_WAIT_MS only — does NOT end guest Latest loading.
# Change kiosk CAPTURE_WAIT_MS first, then keep this value in sync (default 8000).
AGENT_CAPTURE_TIMEOUT_MS=8000
# Runtime Stat+writability probe cadence (ms). MUST be <=2000. watch_ok=false within <=5s on miss.
AGENT_WATCH_PROBE_MS=2000

# none = dry-run (accept POST /trigger, no physical shutter pulse). Production: cmd|serial.
RELAY_MODE=none
# RELAY_MODE=cmd
# RELAY_CMD=powershell -NoProfile -File .\pulse-usb-relay.ps1
# RELAY_SERIAL_PORT=COM3

# --- Chat luong anh UPLOAD (px va MB la 2 knob rieng) ---
# AGENT_MAX_PHOTO_EDGE = canh dai max (px). 3000 = mac dinh kit. 0 = tat resize px.
# AGENT_MAX_PHOTO_BYTES = TRAN sau nen (bytes). Anh > cap se nen xuong <= cap.
#   3145728 = 3 MiB (mac dinh kit) | 5242880 = 5 MiB | 0 = tat cap bytes
AGENT_MAX_PHOTO_EDGE=3000
AGENT_MAX_PHOTO_BYTES=3145728
AGENT_JPEG_QUALITY=92
# Selfie-mirror at ingest so print/gallery match kiosk live (CSS -scale-x-100).
AGENT_MIRROR_PHOTOS=true

# Preview pool: so worker song song cho File Ready Gate + RAM preview (KHONG
# gom compress/POST). Tach rieng khoi upload pool de mot upload cham/retry
# KHONG lam Last Local bi cho theo. Mac dinh 2 (CPU-bound, khong can nhieu).
AGENT_PREVIEW_CONCURRENCY=2

# Burst upload: so worker song song (compress + POST + retry). Mac dinh 3
# de 5-10 shot trong vai giay khong xep hang tuyen tinh. Dat 1 = serial cu
# (moi anh doi het POST/retry cua anh truoc). Queue = max(64, 16xC).
AGENT_UPLOAD_CONCURRENCY=3
# AGENT_UPLOAD_QUEUE_SIZE=64

# Goc bake luc agent KHOI DONG (0|90|180|270, xoay theo chieu kim dong ho).
# Mac dinh 0: X Acquire thuong da ghi JPG dung chieu san, bake them se lam anh
# nghieng NGUOC voi live view. Chi dat khac 0 khi da kiem chung tan mat rang
# file trong WATCH_DIR that su bi nghieng.
# Kiosk POST /orientation ghi de luc chay tu room.photo_rotate_deg (resolve auto→90);
# gia tri nay chi co tac dung truoc khi co kiosk nao mo man chup.
AGENT_ORIENTATION_DEG=0

# Latest local (RAM preview qua /preview/latest.jpg) — publish TRUOC khi nen
# upload. Canh nho + q thap = Latest nhanh; canh lon (1920/q90) de lam cham
# 2–5s tren booth PC yeu vi decode JPG 40MP. Mac dinh code: 1280 / q75.
AGENT_PREVIEW_MAX_EDGE=1280
AGENT_PREVIEW_JPEG_QUALITY=75

# === Khac biet duy nhat so voi kit goc ===
# true = xoa JPG trong WATCH_DIR sau khi API tra OK (ke ca retry OK).
# Upload fail / spool / NO SESSION / stable-wait fail => GIU file.
# Dat false (hoac xoa dong nay) => hanh vi y het kit goc.
AGENT_DELETE_AFTER_UPLOAD=true

# === Do ben cua duong ingest ===
# Khi lookup active-session KHONG tra loi duoc (mat mang, 5xx, body hong), agent
# thu lai trong ngan nay roi moi chiu thua. 404 la cau tra loi that -> tu choi
# ngay, khong cho. 0 = tat retry.
AGENT_BIND_RETRY_MS=2000
# Keep the just-ended session pinned so late X Acquire dumps do not bind to the next guest.
AGENT_STICKY_HANDOFF_SEC=8
# After kiosk Start, keep inbound JPEGs on the previous session (X Acquire dump lag).
AGENT_SESSION_STRAGGLER_SEC=6
# File da nam tren o dia booth lau hon nguong nay = backlog, khong upload.
# Tinh theo thoi diem file XUAT HIEN tren may nay, khong theo dong ho may anh.
AGENT_BACKLOG_MAX_AGE_SEC=120
# Giu dau vet "da upload" bao lau (gio). Het han thi quen, tranh store phinh vo han.
AGENT_UPLOADED_TTL_HOURS=72

# Log ra file (co rotation) de kiem chung DELETED / DELETE FAILED sau moi shot.
AGENT_LOG_FILE=logs\agent.log
AGENT_LOG_MAX_BYTES=5242880
AGENT_LOG_KEEP=3
# Bat khi can dieu tra chi tiet (detect/skip). Mac dinh tat cho gon log.
# AGENT_DEBUG=true

# === Do latency (mac dinh BAT, 2 dong log / anh) ===
# [timeline:preview] = duong Last Local phai cho
# [timeline:upload]  = duong upload (Last Local KHONG cho nua)
# shutter→detect doc tu EXIF DateTimeOriginal cua chinh file JPG => tach duoc
# "X Acquire cham" khoi "agent cham". MUON DUNG SO NAY THI PHAI DAT DONG HO MAY
# ANH = DONG HO MAY TINH (X-T5: SET UP > Date/Time); lech gio se bi log danh dau
# "clock-skew?" va con so vo nghia.
# Dat false neu muon log gon lai.
AGENT_TIMELINE_LOG=true

# Staff kiosk exit PIN (loopback POST /staff-pin/verify). Never ship in the SPA.
# STAFF_PIN=2468
