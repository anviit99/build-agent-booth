# Copy to .env.agent and fill secrets. Do not commit real tokens.
#
# VARIANT: giong booth-hdmi-xacquire NHUNG xoa JPG trong WATCH_DIR sau khi upload OK.
# HDMI live view (kiosk webcam) + X Acquire folder watch + optional RR-100 relay.
# KHONG chay chung USB fuji-bridge soft-shutter tren cung may neu dung HDMI path.
# KHONG chay kit nay song song kit goc tren cung WATCH_DIR (kit nay se xoa file truoc).

API_BASE_URL=http://localhost:8080/api/v1
SERVICE_TOKEN=
ROOM_ID=



# X Acquire: watch THU MUC CHA (recursive) — dung leaf 582_FUJI se miss khi Fuji doi folder.
# KHONG dung WATCH_DIR=auto cho X Acquire (auto chi DCIM/USB the).
WATCH_DIR=C:\Users\PC\Documents\FUJIFILM\XAcquire
# Optional second root neu can (it khi dung khi da watch cha).
# WATCH_DIR_2=
AGENT_MODE=booth
AGENT_AUTO_WALKIN=false

# Loopback-only control HTTP (GET /health /status, POST /trigger). Non-loopback bind forbidden.
AGENT_CONTROL_ADDR=127.0.0.1:8791
# File-ready hold: size unchanged for this many ms (±50). Preferred over legacy poll/timeout.
AGENT_STABLE_HOLD_MS=300
# Docs/status mirror of kiosk CAPTURE_WAIT_MS only — does NOT end guest Latest loading.
AGENT_CAPTURE_TIMEOUT_MS=8000
# Runtime Stat+writability probe cadence (ms). MUST be <=2000. watch_ok=false within <=5s on miss.
AGENT_WATCH_PROBE_MS=2000

# none = dry-run (accept POST /trigger, no physical shutter pulse). Production: cmd|serial.
RELAY_MODE=none
# RELAY_MODE=cmd
# RELAY_CMD=powershell -NoProfile -File .\pulse-usb-relay.ps1
# RELAY_SERIAL_PORT=COM3

# Upload/print (cham, chat luong cao) — khong chan Latest local.
AGENT_MAX_PHOTO_EDGE=3000
AGENT_MAX_PHOTO_BYTES=3145728
AGENT_JPEG_QUALITY=92
AGENT_MIRROR_PHOTOS=true

# Latest local: sweet spot nhanh + net tren man kiosk (publish TRUOC nen upload).
AGENT_PREVIEW_MAX_EDGE=1920
AGENT_PREVIEW_JPEG_QUALITY=90

# === Khac biet duy nhat so voi kit goc ===
# true = xoa JPG trong WATCH_DIR sau khi API tra OK (ke ca retry OK).
# Upload fail / spool / NO SESSION / stable-wait fail => GIU file.
AGENT_DELETE_AFTER_UPLOAD=true

# Log ra file (co rotation) de kiem chung DELETED / DELETE FAILED sau moi shot.
AGENT_LOG_FILE=logs\agent.log
AGENT_LOG_MAX_BYTES=5242880
AGENT_LOG_KEEP=3
# AGENT_DEBUG=true
