# macOS — copy to .env.agent (do not commit secrets).
# VARIANT: X Acquire watch + delete JPG after upload OK (AGENT_DELETE_AFTER_UPLOAD=true).
# Do NOT run two agents on the same WATCH_DIR.
#
# Windows kit (same agent source): setup/booth-hdmi-xacquire-autodelete/

API_BASE_URL=https://harrodsfilm.com/api/v1
SERVICE_TOKEN=
ROOM_ID=

# X Acquire JPG folder (parent — agent watches recursively).
# Mac thuong: Pictures/FUJIFILM (X Acquire Preferences) hoac Documents/FUJIFILM/XAcquire
WATCH_DIR=/Users/YOUR_USER/Pictures/FUJIFILM
# WATCH_DIR_2=/Volumes/OtherDrop

AGENT_MODE=booth
AGENT_AUTO_WALKIN=false

AGENT_CONTROL_ADDR=127.0.0.1:8791
AGENT_STABLE_HOLD_MS=300
AGENT_CAPTURE_TIMEOUT_MS=8000
AGENT_WATCH_PROBE_MS=2000

RELAY_MODE=none

# Upload/print (does not block Latest local preview)
AGENT_MAX_PHOTO_EDGE=3000
AGENT_MAX_PHOTO_BYTES=5242880
AGENT_JPEG_QUALITY=92
AGENT_MIRROR_PHOTOS=true

AGENT_PREVIEW_CONCURRENCY=2
AGENT_UPLOAD_CONCURRENCY=3
AGENT_ORIENTATION_DEG=0

# Latest local (RAM /preview/latest.jpg) — keep small for speed
AGENT_PREVIEW_MAX_EDGE=1280
AGENT_PREVIEW_JPEG_QUALITY=75

# === Autodelete (only diff vs booth-macos) ===
AGENT_DELETE_AFTER_UPLOAD=true

AGENT_BIND_RETRY_MS=2000
AGENT_BACKLOG_MAX_AGE_SEC=120
AGENT_UPLOADED_TTL_HOURS=72

AGENT_LOG_FILE=logs/agent.log
AGENT_LOG_MAX_BYTES=5242880
AGENT_LOG_KEEP=3
AGENT_TIMELINE_LOG=true

# STAFF_PIN=2468
